# Copy to .env.plus and fill in. Never commit .env.plus.

# Your domain, pointing at this server (A/AAAA DNS record)
DOMAIN=draw.example.com

# Long random string; encrypts users' own AI keys. Generate with:
#   openssl rand -base64 32
# Keep it stable: changing it makes stored AI keys unreadable.
PLUS_SECRET=

# Optional: server-wide AI key (else users bring their own)
ANTHROPIC_API_KEY=

# Optional limits
PLUS_AI_DAILY_LIMIT=100
PLUS_AI_ANON_DAILY_LIMIT=10
