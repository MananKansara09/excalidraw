# Copy to .env.plus and fill in. Never commit .env.plus.

# Your domain, served by the host's Caddy (used for share links)
DOMAIN=draw.example.com

# Port on 127.0.0.1 the container listens on; Caddy proxies to it
PLUS_PORT=3015

# Same for the live collaboration container; update Caddy if you change it
ROOM_PORT=3002

# Long random string; encrypts users' own AI keys. Generate with:
#   openssl rand -base64 32
# Keep it stable: changing it makes stored AI keys unreadable.
PLUS_SECRET=

# Optional: server-wide AI key (else users bring their own)
ANTHROPIC_API_KEY=

# Optional limits
PLUS_AI_DAILY_LIMIT=100
PLUS_AI_ANON_DAILY_LIMIT=10

# Optional: WebRTC servers for voice and screen sharing, as a JSON array.
# Add a TURN server so people on strict networks can connect, e.g.
# PLUS_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
PLUS_ICE_SERVERS=
