# Excalidraw with the Plus server: one container serves the web app, the
# REST API, the MCP endpoint and realtime events. See DEPLOY.md.

FROM node:22-bookworm-slim AS build

WORKDIR /opt/node_app

COPY . .

RUN --mount=type=cache,target=/usr/local/share/.cache/yarn \
    yarn --frozen-lockfile --network-timeout 600000

RUN yarn build:app:docker


FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=3015 \
    PLUS_DATA_DIR=/data

WORKDIR /app

# the server needs only its own source and one dependency
COPY plus-server/package.json plus-server/
RUN cd plus-server && npm install --omit=dev --no-package-lock --no-audit --no-fund

COPY plus-server/src plus-server/src
COPY --from=build /opt/node_app/excalidraw-app/build excalidraw-app/build

RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 3015

HEALTHCHECK --interval=30s --timeout=5s \
  CMD node -e "fetch('http://localhost:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "plus-server/src/index.ts"]
