# Site block for the Caddy running on the host. Add it to your Caddyfile
# (usually /etc/caddy/Caddyfile), replace the domain, then reload Caddy.
# The port must match PLUS_PORT in .env.plus (default 3015).

draw.example.com {
	# compress static assets only: event streams must reach clients unbuffered
	encode gzip zstd {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy 127.0.0.1:3015 {
		flush_interval -1
	}
}
