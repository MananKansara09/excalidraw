      "boundElements": null,
      "updated": 1795798837780,
      "created": 1795798837754,
      "link": null,
      "locked": false,
      "text": "Each step:\n• retrieve context + memory\n• call model via router\n• call tools via gateway\n• pause if approval needed\n• checkpoint state\n\nFailures: retry with backoff,\nthen re-plan or escalate.\nLimits: max steps, time, cost.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each step:\n• retrieve context + memory\n• call model via router\n• call tools via gateway\n• pause if approval needed\n• checkpoint state\n\nFailures: retry with backoff,\nthen re-plan or escalate.\nLimits: max steps, time, cost.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
