":385,"width":200,"height":80,"backgroundColor":"#b2f2bb","fillStyle":"solid","label":{"text":"Memory\nshort & long term"}},{"type":"rectangle","id":"rag","x":1140,"y":570,"width":200,"height":80,"backgroundColor":"#b2f2bb","fillStyle":"solid","label":{"text":"Retrieval (RAG)"}},{"type":"ellipse","id":"statedb","x":1440,"y":375,"width":220,"height":100,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"State / KV DB"}},{"type":"ellipse","id":"vecdb","x":1440,"y":560,"width":220,"height":100,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Vector DB"}},{"type":"ellipse","id":"docdb","x":1440,"y":720,"width":220,"height":100,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Document Store"}},{"type":"rectangle","id":"obs","x":60,"y":1090,"width":1600,"height":80,"strokeStyle":"dashed","backgroundColor":"#fff4e6","fillStyle":"solid","label":{"text":"Observability (all components): traces · logs · metrics · evals · cost · audit"}},{"type":"arrow","id":"a1","x":550,"y":150,"start":{"id":"users"},"end":{"id":"api"}},{"type":"arrow","id":"a2","x":850,"y":145,"start":{"id":"apps"},"end":{"id":"api"}},{"type":"arrow","id":"a3","x":700,"y":300,"start":{"id":"api"},"end":{"id":"orch"}},{"type":"arrow","id":"a4","x":600,"y":470,"start":{"id":"orch"},"end":{"id":"plan"}},{"type":"arrow","id":"a5","x":800,"y":470,"start":{"id":"orch"},"end":{"id":"work"}},{"type":"arrow","id":"a6","x":530,"y":650,"start":{"id":"plan"},"end":{"id":"router"}},{"type":"arrow","id":"a7","x":780,"y":650,"start":{"id":"work"},"end":{"id":"router"}},{"type":"arrow","id":"a8","x":870,"y":650,"start":{"id":"work"},"end":{"id":"toolgw"}},{"type":"arrow","id":"a9","x":530,"y":840,"start":{"id":"router"},"end":{"id":"llm"}},{"type":"arrow","id":"a10","x":870,"y":840,"start":{"id":"toolgw"},"end":{"id":"ext"}},{"type":"arrow","id":"a11","x":550,"y":400,"start":{"id":"orch"},"end":{"id":"guard"},"label":{"text":"policy checks","fontSize":16}},{"type":"arrow","id":"a12","x":550,"y":450,"start":{"id":"orch"},"end":{"id":"human"},"label":{"text":"risky actions","fontSize":16}},{"type":"arrow","id":"a13","x":850,"y":425,"start":{"id":"orch"},"end":{"id":"mem"},"label":{"text":"read / write","fontSize":16}},{"type":"arrow","id":"a14","x":980,"y":610,"start":{"id":"work"},"end":{"id":"rag"}},{"type":"arrow","id":"a15","x":1340,"y":425,"start":{"id":"mem"},"end":{"id":"statedb"}},{"type":"arrow","id":"a16","x":1340,"y":610,"start":{"id":"rag"},"end":{"id":"vecdb"}},{"type":"arrow","id":"a17","x":1340,"y":640,"start":{"id":"rag"},"end":{"id":"docdb"}}]},{"turn":2,"op":"add","elements":[{"type":"text","id":"f1t","x":1830,"y":30,"text":"1. Agent Execution Flow","fontSize":28},{"type":"rectangle","id":"f1a","x":1860,"y":90,"width":300,"height":60,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"1. Receive & authenticate","fontSize":16}},{"type":"rectangle","id":"f1b","x":1860,"y":190,"width":300,"height":60,"backgroundColor":"#ffc9c9","fillStyle":"solid","label":{"text":"2. Input guardrails","fontSize":16}},{"type":"rectangle","id":"f1c","x":1860,"y":290,"width":300,"height":60,"backgroundColor":"#d0bfff","fillStyle":"solid","label":{"text":"3. Plan: split into steps","fontSize":16}},{"type":"rectangle","id":"f1d","x":1860,"y":390,"width":300,"height":60,"backgroundColor":"#d0bfff","fillStyle":"solid","label":{"text":"4. Worker runs next step","fontSize":16}},{"type":"diamond","id":"f1e","x":1880,"y":490,"width":260,"height":100,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"All steps done?","fontSize":16}},{"type":"rectangle","id":"f1f","x":1860,"y":640,"width":300,"height":60,"backgroundColor":"#b2f2bb","fillStyle":"solid","label":{"text":"5. Output checks & respond","fontSize":16}},{"type":"text","id":"f1n","x":2230,"y":390,"text":"Each step:\n• retrieve context + memory\n• call model via router\n• call tools via gateway\n• pause if approval needed\n• checkpoint state\n\nFailures: retry with backoff,\nthen re-plan or escalate.\nLimits: max steps, time, cost.","fontSize":16},{"type":"arrow","id":"f1r1","x":2010,"y":150,"start":{"id":"f1a"},"end":{"id":"f1b"}},{"type":"arrow","id":"f1r2","x":2010,"y":250,"start":{"id":"f1b"},"end":{"id":"f1c"}},{"type":"arrow","id":"f1r3","x":2010,"y":350,"start":{"id":"f1c"},"end":{"id":"f1d"}},{"type":"arrow","id":"f1r4","x":2010,"y":450,"start":{"id":"f1d"},"end":{"id":"f1e"}},{"type":"arrow","id":"f1r5","x":2010,"y":590,"width":0,"height":50},{"type":"text","id":"f1yes","x":2025,"y":605,"text":"yes","fontSize":16},{"type":"line","id":"f1l1","x":1880,"y":540,"width":-50,"height":0},{"type":"line","id":"f1l2","x":1830,"y":540,"width":0,"height":-120},{"type":"arrow","id":"f1l3","x":1830,"y":420,"width":30,"height":0},{"type":"text","id":"f1no","x":1845,"y":545,"text":"no","fontSize":16},{"type":"text","id":"f2t","x":2650,"y":30,"text":"2. Data Model","fontSize":28},{"type":"rectangle","id":"f2ten","x":2660,"y":100,"width":240,"height":110,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Tenant\nid (PK)\nname, region","fontSize":16}},{"type":"rectangle","id":"f2ag","x":3080,"y":100,"width":240,"height":110,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Agent\nid, tenant_id (FK)\nversion, tools, policy","fontSize":16}},{"type":"rectangle","id":"f2run","x":3080,"y":300,"width":240,"height":110,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Run\nid, agent_id (FK)\nuser_id, status, cost","fontSize":16}},{"type":"rectangle","id":"f2step","x":3080,"y":520,"width":240,"height":110,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Step\nid, run_id (FK)\ntype, input, output","fontSize":16}},{"type":"rectangle","id":"f2mem","x":2660,"y":300,"width":240,"height":110,"backgroundColor":"#b2f2bb","fillStyle":"solid","label":{"text":"Memory Item\nid, tenant_id (FK)\nscope, embedding, ttl","fontSize":16}},{"type":"rectangle","id":"f2app","x":2660,"y":520,"width":240,"height":110,"backgroundColor":"#ffc9c9","fillStyle":"solid","label":{"text":"Approval\nid, step_id (FK)\napprover, decision","fontSize":16}},{"type":"arrow","id":"f2r1","x":2900,"y":155,"start":{"id":"f2ten"},"end":{"id":"f2ag"},"label":{"text":"1 : N","fontSize":16}},{"type":"arrow","id":"f2r2","x":2780,"y":210,"start":{"id":"f2ten"},"end":{"id":"f2mem"},"label":{"text":"1 : N","fontSize":16}},{"type":"arrow","id":"f2r3","x":3200,"y":210,"start":{"id":"f2ag"},"end":{"id":"f2run"},"label":{"text":"1 : N","fontSize":16}},{"type":"arrow","id":"f2r4","x":3200,"y":410,"start":{"id":"f2run"},"end":{"id":"f2step"},"label":{"text":"1 : N","fontSize":16}},{"type":"arrow","id":"f2r5","x":3080,"y":575,"start":{"id":"f2step"},"end":{"id":"f2app"},"label":{"text":"1 : 0..1","fontSize":16}},{"type":"text","id":"f2n","x":2660,"y":670,"text":"Every record is tenant-scoped (directly or via its parent).","fontSize":16},{"type":"text","id":"f3t","x":3470,"y":30,"text":"3. API Contract (v1)","fontSize":28},{"type":"text","id":"f3b","x":3470,"y":90,"fontSize":18,"text":"Auth: OAuth 2.0 / OIDC bearer token\n\nPOST /v1/runs\n    start a run (Idempotency-Key header) → 202\nGET /v1/runs/{id}\n    status, result, cost\nGET /v1/runs/{id}/events\n    live progress (SSE)\nPOST /v1/runs/{id}/cancel\n    stop a run\nPOST /v1/approvals/{id}\n    { decision: approve | reject, comment }\n\nRequest: { agent_id, input, context?, max_cost? }\nResponse: { run_id, status }\n\nStatus: queued, running, waiting_approval,\nsucceeded, failed, cancelled\n\nErrors: 400, 401, 403, 404, 409, 429\n{ code, message, trace_id }"},{"type":"text","id":"f4t","x":1830,"y":850,"text":"4. Security & Guardrails","fontSize":28},{"type":"text","id":"f4b","x":1830,"y":910,"fontSize":18,"text":"Identity & access\n• SSO, RBAC / ABAC per tenant and agent\n• Agents act with the user's delegated scopes\n\nData protection\n• TLS in transit, AES-256 at rest\n• Secrets in a vault, never in prompts\n• PII detection and redaction\n• Retrieval filtered by document permissions\n\nGuardrails\n• Input: prompt injection and jailbreak checks\n• Tools: allow-list, schema validation, sandbox\n• Output: safety, leakage, grounding checks\n• High-risk actions need human approval\n\nAudit: append-only log of prompts, calls, decisions"},{"type":"text","id":"f5t","x":2650,"y":850,"text":"5. Deployment","fontSize":28},{"type":"rectangle","id":"f5edge","x":2840,"y":920,"width":300,"height":70,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"Load Balancer + WAF","fontSize":16}},{"type":"rectangle","id":"f5k8s","x":2700,"y":1060,"width":580,"height":120,"backgroundColor":"#d0bfff","fillStyle":"solid","label":{"text":"Kubernetes (3 availability zones)\nAPI · orchestrator · agent workers\ntool gateway · model router · guardrails","fontSize":16}},{"type":"rectangle","id":"f5data","x":2700,"y":1260,"width":580,"height":80,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Managed data: state DB · vector DB · object store · queue","fontSize":16}},{"type":"arrow","id":"f5r1","x":2990,"y":990,"start":{"id":"f5edge"},"end":{"id":"f5k8s"}},{"type":"arrow","id":"f5r2","x":2990,"y":1180,"start":{"id":"f5k8s"},"end":{"id":"f5data"}},{"type":"text","id":"f5n","x":2700,"y":1380,"fontSize":16,"text":"Environments: dev → staging → prod (infrastructure as code)\nRelease: canary with eval gates, automatic rollback\nWorkers autoscale on queue depth\nDisaster recovery: cross-region replicas and backups"},{"type":"text","id":"f6t","x":3470,"y":850,"text":"6. Non-Functional Requirements","fontSize":28},{"type":"rectangle","id":"f6h","x":3470,"y":910,"width":220,"height":60,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"Attribute","fontSize":18}},{"type":"rectangle","id":"f6hv","x":3690,"y":910,"width":450,"height":60,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"Proposed target","fontSize":18}},{"type":"rectangle","id":"f6k1","x":3470,"y":970,"width":220,"height":60,"label":{"text":"Availability","fontSize":16}},{"type":"rectangle","id":"f6v1","x":3690,"y":970,"width":450,"height":60,"label":{"text":"99.9% monthly","fontSize":16}},{"type":"rectangle","id":"f6k2","x":3470,"y":1030,"width":220,"height":60,"label":{"text":"Latency","fontSize":16}},{"type":"rectangle","id":"f6v2","x":3690,"y":1030,"width":450,"height":60,"label":{"text":"API p95 < 300 ms; first token p95 < 3 s","fontSize":16}},{"type":"rectangle","id":"f6k3","x":3470,"y":1090,"width":220,"height":60,"label":{"text":"Scale","fontSize":16}},{"type":"rectangle","id":"f6v3","x":3690,"y":1090,"width":450,"height":60,"label":{"text":"1,000 concurrent runs, horizontal growth","fontSize":16}},{"type":"rectangle","id":"f6k4","x":3470,"y":1150,"width":220,"height":60,"label":{"text":"Recovery","fontSize":16}},{"type":"rectangle","id":"f6v4","x":3690,"y":1150,"width":450,"height":60,"label":{"text":"RPO ≤ 5 min, RTO ≤ 1 hour","fontSize":16}},{"type":"rectangle","id":"f6k5","x":3470,"y":1210,"width":220,"height":60,"label":{"text":"Observability","fontSize":16}},{"type":"rectangle","id":"f6v5","x":3690,"y":1210,"width":450,"height":60,"label":{"text":"100% of runs traced","fontSize":16}},{"type":"rectangle","id":"f6k6","x":3470,"y":1270,"width":220,"height":60,"label":{"text":"Compliance","fontSize":16}},{"type":"rectangle","id":"f6v6","x":3690,"y":1270,"width":450,"height":60,"label":{"text":"SOC 2, GDPR, data residency","fontSize":16}},{"type":"rectangle","id":"f6k7","x":3470,"y":1330,"width":220,"height":60,"label":{"text":"Cost","fontSize":16}},{"type":"rectangle","id":"f6v7","x":3690,"y":1330,"width":450,"height":60,"label":{"text":"Budgets and alerts per tenant and run","fontSize":16}},{"type":"frame","id":"fr1","name":"Agent Execution Flow","x":1800,"y":0,"width":760,"height":760,"children":["f1t","f1a","f1b","f1c","f1d","f1e","f1f","f1n","f1r1","f1r2","f1r3","f1r4","f1r5","f1yes","f1l1","f1l2","f1l3","f1no"]},{"type":"frame","id":"fr2","name":"Data Model","x":2620,"y":0,"width":760,"height":760,"children":["f2t","f2ten","f2ag","f2run","f2step","f2mem","f2app","f2r1","f2r2","f2r3","f2r4","f2r5","f2n"]},{"type":"frame","id":"fr3","name":"API Contract","x":3440,"y":0,"width":760,"height":760,"children":["f3t","f3b"]},{"type":"frame","id":"fr4","name":"Security and Guardrails","x":1800,"y":820,"width":760,"height":700,"children":["f4t","f4b"]},{"type":"frame","id":"fr5","name":"Deployment","x":2620,"y":820,"width":760,"height":700,"children":["f5t","f5edge","f5k8s","f5data","f5r1","f5r2","f5n"]},{"type":"frame","id":"fr6","name":"Non-Functional Requirements","x":3440,"y":820,"width":760,"height":700,"children":["f6t","f6h","f6hv","f6k1","f6v1","f6k2","f6v2","f6k3","f6v3","f6k4","f6v4","f6k5","f6v5","f6k6","f6v6","f6k7","f6v7"]}]},{"turn":3,"op":"add","elements":[{"type":"rectangle","id":"s1bar","x":140,"y":1860,"width":16,"height":300,"backgroundColor":"#d0bfff","fillStyle":"solid","strokeColor":"#d0bfff"},{"type":"text","id":"s1t","x":200,"y":1870,"text":"Atlas","fontSize":96},{"type":"text","id":"s1s","x":200,"y":2010,"text":"AI assistants that get work done,\nwith your people in control","fontSize":40},{"type":"text","id":"s1f","x":200,"y":2330,"text":"Client introduction","fontSize":24,"strokeColor":"#495057"},{"type":"text","id":"s2t","x":1500,"y":1780,"text":"The challenge","fontSize":44},{"type":"text","id":"s2s","x":1500,"y":1850,"text":"Skilled people lose time to routine work","fontSize":28,"strokeColor":"#495057"},{"type":"rectangle","id":"s2a","x":1500,"y":1980,"width":360,"height":280,"backgroundColor":"#ffc9c9","fillStyle":"solid","label":{"text":"Scattered information\n\nAnswers are spread\nacross many systems\nand documents","fontSize":24}},{"type":"rectangle","id":"s2b","x":1900,"y":1980,"width":360,"height":280,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"Repetitive tasks\n\nStaff copy, check and\nchase the same things\nevery day","fontSize":24}},{"type":"rectangle","id":"s2c","x":2300,"y":1980,"width":360,"hei