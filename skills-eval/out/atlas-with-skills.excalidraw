      "updated": 1795798837538,
      "created": 1795798837533,
      "link": null,
      "locked": false,
      "text": "Endpoint\n\nPOST /v1/runs\n\nGET  /v1/runs/{id}\n\nGET  /v1/runs/{id}/events\n\nPOST /v1/runs/{id}/cancel\n\nPOST /v1/approvals/{id}\n\nGET  /v1/tools",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Endpoint\n\nPOST /v1/runs\n\nGET  /v1/runs/{id}\n\nGET  /v1/runs/{id}/events\n\nPOST /v1/runs/{id}/cancel\n\nPOST /v1/approvals/{id}\n\nGET  /v1/tools",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "p2",
      "type": "text",
      "x": 4400,
      "y": 130,
      "width": 214.27182006835938,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F3",
      "index": "az",
      "roundness": null,
