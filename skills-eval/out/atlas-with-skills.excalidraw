      "link": null,
      "locked": false,
      "text": "Auth: OAuth 2.0 bearer token; tenant comes from the token, never the body\nStatuses: queued, running, awaiting_approval, succeeded, failed, cancelled\nErrors: 400 invalid, 401 / 403 auth, 409 idempotency conflict,\n422 blocked by guardrail, 429 quota (with Retry-After)",
      "fontSize": 16,
      "baseFontSize": null,
