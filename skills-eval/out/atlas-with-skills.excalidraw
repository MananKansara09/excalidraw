      "isDeleted": false,
      "boundElements": null,
      "updated": 1795798837538,
      "created": 1795798837534,
      "link": null,
      "locked": false,
      "text": "Purpose\n\nStart a run (returns 202)\n\nStatus, result, cost\n\nLive step stream (SSE)\n\nStop a run\n\nApprove or reject an action\n\nTools this caller may use",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Purpose\n\nStart a run (returns 202)\n\nStatus, result, cost\n\nLive step stream (SSE)\n\nStop a run\n\nApprove or reject an action\n\nTools this caller may use",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
