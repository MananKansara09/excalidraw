      "locked": false,
      "text": "Release path: dev, then staging (agent evals must pass), then prod canary at 5%, then 100%.\nInfrastructure as code; automatic rollback on error or eval regression.\nObservability collectors run in every zone we operate.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Release path: dev, then staging (agent evals must pass), then prod canary at 5%, then 100%.\nInfrastructure as code; automatic rollback on error or eval regression.\nObservability collectors run in every zone we operate.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
