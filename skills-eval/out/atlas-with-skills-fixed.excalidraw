      "created": 1795803211155,
      "link": null,
      "locked": false,
      "text": "Auth: OAuth 2.0 bearer token; tenant is taken from the token.\nRun status: queued, running, waiting_approval, succeeded, failed, cancelled.\nErrors: 400 invalid, 401 unauthenticated, 403 forbidden or blocked by policy,\n404 not found, 409 conflict, 429 rate limited (Retry-After).",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Auth: OAuth 2.0 bearer token; tenant is taken from the token.\nRun status: queued, running, waiting_approval, succeeded, failed, cancelled.\nErrors: 400 invalid, 401 unauthenticated, 403 forbidden or blocked by policy,\n404 not found, 409 conflict, 429 rate limited (Retry-After).",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
