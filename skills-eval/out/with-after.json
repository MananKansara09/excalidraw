"#e9ecef","fillStyle":"solid","label":{"text":"202 Accepted\n{\n  \"run_id\": \"run_8f2c\",\n  \"status\": \"queued\",\n  \"events_url\":\n   \"/v1/runs/run_8f2c/events\"\n}","fontSize":16}},{"type":"text","id":"pnote","x":4440,"y":728,"text":"Auth: OAuth 2.0 bearer token; tenant is taken from the token.\nRun status: queued, running, waiting_approval, succeeded, failed, cancelled.\nErrors: 400 invalid, 401 unauthenticated, 403 forbidden or blocked by policy,\n404 not found, 409 conflict, 429 rate limited (Retry-After).","fontSize":16},{"type":"frame","id":"fr3","name":"API contract","x":4400,"y":-80,"width":960,"height":1000,"children":["d3t","p0a","p0b","p1a","p1b","p2a","p2b","p3a","p3b","p4a","p4b","p5a","p5b","p6a","p6b","preq","pres","pnote"]},{"type":"text","id":"d4t","x":2200,"y":1032,"text":"4. Security: five checkpoints, all fail closed","fontSize":28},{"type":"rectangle","id":"s1","x":2200,"y":1112,"width":240,"height":80,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"1. Identity","fontSize":20}},{"type":"rectangle","id":"s2","x":2200,"y":1252,"width":240,"height":80,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"2. Input checks","fontSize":20}},{"type":"rectangle","id":"s3","x":2200,"y":1392,"width":240,"height":80,"backgroundColor":"#b2f2bb","fillStyle":"solid","label":{"text":"3. Tool access","fontSize":20}},{"type":"rectangle","id":"s4","x":2200,"y":1532,"width":240,"height":80,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"4. Human approval","fontSize":20}},{"type":"rectangle","id":"s5","x":2200,"y":1672,"width":240,"height":80,"backgroundColor":"#ffec99","fillStyle":"solid","label":{"text":"5. Output checks","fontSize":20}},{"type":"text","id":"s1n","x":2480,"y":1130,"text":"SSO (OIDC), role-based access, per-tenant rate limits\nStops: unknown callers, cross-tenant access","fontSize":16},{"type":"text","id":"s2n","x":2480,"y":1270,"text":"Prompt-injection screening, PII redaction, policy filters\nRetrieved documents and tool results are treated as untrusted","fontSize":16},{"type":"text","id":"s3n","x":2480,"y":1410,"text":"Least-privilege scopes per agent, short-lived secrets, allow-list\nStops: agents calling tools or data they were not granted","fontSize":16},{"type":"text","id":"s4n","x":2480,"y":1550,"text":"Required for payments, deletes, external messages, access changes\nRequester cannot approve their own action","fontSize":16},{"type":"text","id":"s5n","x":2480,"y":1690,"text":"Data-leak and unsafe-content scan, schema validation\nStops: secrets or PII leaving the platform","fontSize":16},{"type":"arrow","id":"sa1","x":2320,"y":1192,"start":{"id":"s1"},"end":{"id":"s2"}},{"type":"arrow","id":"sa2","x":2320,"y":1332,"start":{"id":"s2"},"end":{"id":"s3"}},{"type":"arrow","id":"sa3","x":2320,"y":1472,"start":{"id":"s3"},"end":{"id":"s4"}},{"type":"arrow","id":"sa4","x":2320,"y":1612,"start":{"id":"s4"},"end":{"id":"s5"}},{"type":"rectangle","id":"saud","x":2200,"y":1808,"width":920,"height":96,"backgroundColor":"#e9ecef","fillStyle":"solid","strokeStyle":"dashed","label":{"text":"Always on: TLS in transit, encryption at rest,\nappend-only audit log of every decision, model call and tool call","fontSize":16}},{"type":"frame","id":"fr4","name":"Security and guardrails","x":2160,"y":1000,"width":1000,"height":960,"children":["d4t","s1","s2","s3","s4","s5","s1n","s2n","s3n","s4n","s5n","sa1","sa2","sa3","sa4","saud"]},{"type":"text","id":"d5t","x":3280,"y":1032,"text":"5. Deployment: only the edge is public","fontSize":28},{"type":"rectangle","id":"z1","x":3300,"y":1104,"width":960,"height":120,"backgroundColor":"#a5d8ff","fillStyle":"solid","label":{"text":"Public edge\nWAF, load balancer, API gateway","fontSize":20}},{"type":"rectangle","id":"z2","x":3300,"y":1304,"width":960,"height":184,"backgroundColor":"#d0bfff","fillStyle":"solid","label":{"text":"Private app cluster (Kubernetes, 3 availability zones)\nGuardrails, orchestrator, approval service: 3+ 